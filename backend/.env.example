# Copy to .env — never commit real values. Validated at boot by src/config/env.ts (Zod):
# the API refuses to start if a required value is missing, and in production it also
# requires real JWT secrets, Cloudinary, SMTP/Resend, a captcha secret and a real
# Nominatim contact.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the API (nginx / load balancer) — needed for correct req.ip.
TRUST_PROXY=1

# --- Origins (CORS allow-list, credentials enabled; also used in email links) ---
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
# Extra allowed origins, comma-separated (e.g. `vite preview`).
CORS_ORIGINS=http://localhost:4173
# Public URL of this API (newsletter confirm/unsubscribe links).
API_PUBLIC_URL=http://localhost:4000

# --- MongoDB (docker-compose locally; MongoDB Atlas in production) ---
MONGODB_URI=mongodb://niraum:niraum-dev@localhost:27017/niraum?authSource=admin

# --- JWT (generate each with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie domain — leave empty for host-only cookies (recommended).
COOKIE_DOMAIN=

# --- Login hardening ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Cloudinary (media; everything is stored under CLOUDINARY_FOLDER/) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=niraum

# --- Email: SMTP (Mailpit in docker-compose: http://localhost:8025) or Resend ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# If set, email goes through the Resend HTTP API instead of SMTP.
RESEND_API_KEY=
# PLACEHOLDER addresses — real company mailboxes not yet confirmed.
MAIL_FROM="Niraum Metals <no-reply@example.com>"
CONTACT_INBOX=contact@example.com
# Job applications (defaults to CONTACT_INBOX).
HR_INBOX=

# --- Geocoding (Nominatim usage policy: identify the app + a contact) ---
NOMINATIM_USER_AGENT="NiraumMetalsWebsite/0.1 (dev@example.com)"
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Spam protection: set ONE (Turnstile preferred). Empty = skipped (dev only). ---
TURNSTILE_SECRET=
RECAPTCHA_SECRET=

# --- First admin (used once by `pnpm seed`; must change password on first login) ---
SEED_ADMIN_NAME=Site Owner
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# --- Static site rebuild (prerendered pages refresh after content is published) ---
# Vercel / Netlify deploy hook URL; called (debounced) when published content changes.
# PLACEHOLDER — empty disables the hook.
REBUILD_HOOK_URL=
REBUILD_DEBOUNCE_SECONDS=120
