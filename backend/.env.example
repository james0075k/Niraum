# Copy to .env — never commit real values. Validated at boot by src/config/env.ts (Zod).

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS, credentials enabled).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Number of proxies in front of the API (nginx / load balancer) — needed for correct req.ip.
TRUST_PROXY=1
LOG_LEVEL=info
PUBLIC_SITE_URL=http://localhost:5173

# --- MongoDB (docker-compose locally; MongoDB Atlas in production) ---
MONGODB_URI=mongodb://niraum:niraum-dev@localhost:27017/niraum?authSource=admin

# --- JWT (generate each with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie domain — leave empty for host-only cookies (recommended).
COOKIE_DOMAIN=

# --- Login hardening ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=niraum
UPLOAD_MAX_MB=10

# --- Email (Nodemailer SMTP; Mailpit in docker-compose for dev: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# PLACEHOLDER addresses — real company mailboxes not yet confirmed.
MAIL_FROM="Niraum Metals <no-reply@example.com>"
MAIL_TO_CONTACT=contact@example.com

# --- Geocoding (Nominatim / OpenStreetMap; usage policy requires an identifying UA/email) ---
GEOCODER_PROVIDER=openstreetmap
GEOCODER_EMAIL=dev@example.com

# --- First admin (used once by `pnpm seed`; change password after first login) ---
SEED_ADMIN_NAME=Site Owner
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# --- Static site rebuild (prerendered pages refresh after content is published) ---
# Deploy hook URL of the frontend host; called (debounced) when published content changes.
# PLACEHOLDER — empty disables the hook.
REBUILD_HOOK_URL=
REBUILD_DEBOUNCE_SECONDS=120
