# Copy to .env.local — every VITE_* value is PUBLIC (shipped to the browser). Never put secrets here.

# Base URL of the REST API. Use the relative path in dev (Vite proxies /api → backend:4000).
VITE_API_URL=/api/v1
# Absolute public site origin — used for canonical URLs, sitemap and Open Graph.
VITE_SITE_URL=http://localhost:5173
# API origin used by the prerender step (vite-react-ssg) to fetch slugs at build time.
SSG_API_URL=http://localhost:4000/api/v1

# OpenStreetMap tile server (respect the OSM tile usage policy; switch to a provider for production).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional analytics (leave empty to disable). PLACEHOLDER — not yet chosen.
VITE_ANALYTICS_ID=
